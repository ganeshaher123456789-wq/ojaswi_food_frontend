# ========================================================
# OJASWI PREMIUM SPICES - FRONTEND ENVIRONMENT CONFIGURATION
# ========================================================
# When deploying to Vercel:
# Set this environment variable in Vercel Project Settings -> Environment Variables.
# Value should be your deployed Render backend URL (no trailing slash).
# Example: https://ojaswi-backend.onrender.com

# For Vite / Modern Bundlers
VITE_API_URL=http://localhost:5000

# Public / Generic Frontend API URL
PUBLIC_API_URL=http://localhost:5000
